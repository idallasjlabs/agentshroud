# Model profile overrides written by scripts/switch_model.sh
AGENTSHROUD_MODEL_MODE=local
AGENTSHROUD_LOCAL_MODEL_REF=ollama/qwen3:14b
AGENTSHROUD_CLOUD_MODEL_REF=anthropic/claude-opus-4-6
AGENTSHROUD_LOCAL_MODEL=qwen3:14b
OPENCLAW_MAIN_MODEL=ollama/qwen3:14b
OPENCLAW_OLLAMA_API=ollama
OLLAMA_API_KEY=ollama-local

# LLM quota failover — automatically re-dispatch to local Ollama when cloud quota exhausted
# Set to 0 to disable; 1 to enable (default when running via docker-compose).
# Ollama must be running on host.docker.internal:11434 for failover to work.
AGENTSHROUD_FAILOVER_ON_QUOTA=1

# Deployment identity — parameterized to avoid hardcoding personal infrastructure
AGENTSHROUD_SLACK_OWNER_USER_ID=YOUR_SLACK_USER_ID
AGENTSHROUD_CONTROL_UI_ORIGINS=http://localhost:18790,https://localhost:18790
AGENTSHROUD_DNS_PRIMARY=1.1.1.1
AGENTSHROUD_DNS_SECONDARY=8.8.8.8
OPENCLAW_BOT_EMAIL=bot@example.com
