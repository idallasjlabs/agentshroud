# docker/versions.env — single source of truth for vendored bot versions AND
# AgentShroud's own product version.
#
# Read by: docker/bots/openclaw/Dockerfile, docker/bots/hermes/Dockerfile (as build
# args via docker-compose.yml's build.args), scripts/update-agentshroud.sh,
# scripts/asb, scripts/canary-deploy.sh, .github/workflows/update-cve-page.yml,
# scripts/sync-cve-registry.py. All of these must agree on the same version — this
# file is the only place that gets edited to bump a vendor version.
#
# To update a VENDOR version: run
# `scripts/update-agentshroud.sh --bot <openclaw|hermes|both> --latest` (it edits
# this file itself after a passing compatibility check). Do not hand-edit this file
# directly outside of that flow unless you know what you're doing — an untested
# bump here goes straight into the next `docker compose build`.
#
# To update AGENTSHROUD_VERSION: run `scripts/sync-version.sh` after bumping
# gateway/__init__.py's __version__ — that file is the actual source of truth;
# this line is a generated mirror consumed by Docker builds/gateway/openclaw/
# hermes runtime env (voice_gateway/server.py's spoken version answer, the SOC
# service list's version label, etc.). CI (.github/workflows/release.yml) runs
# `scripts/sync-version.sh --check` and fails the release if this has drifted.
#
# Not gitignored (.gitignore only matches `.env`/`.env.*`, not `versions.env`) —
# this file is meant to be committed and reviewed like any other config change.

# AgentShroud's own product version (gateway/__init__.py's __version__, mirrored
# here — see scripts/sync-version.sh). Consumed as a build ARG (Docker image
# LABEL org.opencontainers.image.version, gateway/Dockerfile,
# docker/bots/openclaw/Dockerfile, docker/bots/hermes/Dockerfile) and as a
# runtime env var (voice_gateway/server.py's system prompt, so the voice
# assistant answers "what version" questions from real data instead of
# guessing — live regression 2026-08-08: it answered "1.0.0" from nowhere).
AGENTSHROUD_VERSION=1.4.0

# OpenClaw: npm package version (docker/bots/openclaw/Dockerfile ARG OPENCLAW_VERSION)
OPENCLAW_VERSION=2026.7.1

# Hermes: full vendor image reference, digest-pinned for supply-chain integrity
# (docker/bots/hermes/Dockerfile ARG HERMES_IMAGE). Refresh with:
#   docker pull nousresearch/hermes-agent:latest && \
#   docker inspect --format='{{index .RepoDigests 0}}' nousresearch/hermes-agent:latest
HERMES_IMAGE=nousresearch/hermes-agent@sha256:68e15ae2a6d894d0ccbd9f8aacbbe13d4d28fa5dc9b6a303970b67bb2499b1a6

# Hermes: human-readable semver of the digest above, for CVE/NVD matching only
# (the digest itself is not an NVD lookup key). Keep in sync with HERMES_IMAGE —
# bump both together.
HERMES_VERSION=0.20.1
