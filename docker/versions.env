# docker/versions.env — single source of truth for vendored bot versions.
#
# Read by: docker/bots/openclaw/Dockerfile, docker/bots/hermes/Dockerfile (as build
# args via docker-compose.yml's build.args), scripts/update-agentshroud.sh,
# scripts/asb, scripts/canary-deploy.sh, .github/workflows/update-cve-page.yml,
# scripts/sync-cve-registry.py. All of these must agree on the same version — this
# file is the only place that gets edited to bump a vendor version.
#
# To update: run `scripts/update-agentshroud.sh --bot <openclaw|hermes|both> --latest`
# (it edits this file itself after a passing compatibility check). Do not hand-edit
# this file directly outside of that flow unless you know what you're doing — an
# untested bump here goes straight into the next `docker compose build`.
#
# Not gitignored (.gitignore only matches `.env`/`.env.*`, not `versions.env`) —
# this file is meant to be committed and reviewed like any other config change.

# OpenClaw: npm package version (docker/bots/openclaw/Dockerfile ARG OPENCLAW_VERSION)
OPENCLAW_VERSION=2026.7.1

# Hermes: full vendor image reference, digest-pinned for supply-chain integrity
# (docker/bots/hermes/Dockerfile ARG HERMES_IMAGE). Refresh with:
#   docker pull nousresearch/hermes-agent:latest && \
#   docker inspect --format='{{index .RepoDigests 0}}' nousresearch/hermes-agent:latest
HERMES_IMAGE=nousresearch/hermes-agent@sha256:e2adeb75300977c509fa363c64a2b0bddac7b6e02888403cd79dd314d8467061

# Hermes: human-readable semver of the digest above, for CVE/NVD matching only
# (the digest itself is not an NVD lookup key). Keep in sync with HERMES_IMAGE —
# bump both together.
HERMES_VERSION=0.18.2
