#
# AgentShroud-managed Hermes Agent default config.
# Seeded into /opt/data/config.yaml on first boot by init-config.sh.
# After first boot, this file is owned by the hermes-config volume —
# do not expect container rebuilds to overwrite it.

identity:
  name: "AgentShroud Hermes"
  description: "Hermes Agent secured by AgentShroud™ governance proxy"
  # Owner-only access for v1.4.0 launch. Add collaborator IDs after smoke tests pass.
  # TELEGRAM_ALLOWED_USERS env var is the primary control — set in docker-compose.yml.

# Gateway API (OpenAI-compatible, used by /forward route_to=hermes)
api:
  enabled: true
  host: "0.0.0.0"
  port: 8642
  # API_SERVER_KEY is set via API_SERVER_KEY env var (from docker-compose or secret)

# Web dashboard (fronted by gateway auth-proxy on marvin: 127.0.0.1:9119)
dashboard:
  enabled: true
  host: "0.0.0.0"
  port: 9119

# LLM providers — all routed through the AgentShroud gateway for
# PII redaction, audit logging, and IEC 62443 FR3/FR6 compliance.
providers:
  default: anthropic
  anthropic:
    base_url: "http://gateway:8080"
  openai:
    base_url: "http://gateway:8080"
  ollama:
    base_url: "http://gateway:8080/v1"

# Messaging channels
channels:
  telegram:
    enabled: true
    mode: long_poll
    # TELEGRAM_BOT_TOKEN and TELEGRAM_ALLOWED_USERS set by start.sh / docker-compose.yml
    # TELEGRAM_HOME_CHANNEL set by docker-compose.yml
  slack:
    enabled: true
    mode: socket
    # SLACK_BOT_TOKEN and SLACK_APP_TOKEN set by start.sh

# Tools
tools:
  web:
    search:
      enabled: true
      provider: brave
      # BRAVE_API_KEY set by start.sh
  browser:
    enabled: false  # Enable explicitly if playwright is needed in container

# Cron / scheduled automations
cron:
  enabled: true
  jobs_file: "/opt/data/cron/jobs.yaml"
  max_concurrent: 1

# Security — all egress goes through gateway:8181 (set via HTTP_PROXY env var).
# No direct outbound connections from this container.
security:
  # Trusted proxy — all API calls route through http://gateway:8181
  trust_proxy: true
