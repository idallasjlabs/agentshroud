{
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(chmod:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(conda run:*)",
      "Bash(ruff:*)",
      "Bash(black:*)",
      "Bash(pytest:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(gitleaks:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(colima:*)",
      "Bash(limactl:*)",
      "Bash(pip:*)",
      "Bash(uv:*)",
      "Bash(mypy:*)",
      "Bash(semgrep:*)",
      "Bash(shellcheck:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(conda:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(awk:*)",
      "Bash(sed:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(jq:*)",
      "Bash(stat:*)",
      "Bash(file:*)",
      "Bash(df:*)",
      "Bash(du:*)",
      "Bash(ps:*)",
      "Bash(lsof:*)",
      "Bash(sysctl:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(true)",
      "Bash(false)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(tar:*)",
      "Bash(rsync:*)",
      "Bash(tee:*)",
      "Bash(xargs:*)",
      "Bash(timeout:*)",
      "Bash(curl:*)",
      "Bash(tmux:*)",
      "Bash(scripts/:*)",
      "Bash(docker/scripts/:*)",
      "Bash(bash scripts/:*)"
    ],
    "deny": [
      "Read(docker/secrets/**)",
      "Read(.agentshroud/secrets/**)",
      "Read(/run/secrets/**)",
      "Read(**/history.env)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  },
  "model": "sonnet",
  "agentPushNotifEnabled": true,
  "tui": "fullscreen",
  "remoteControlAtStartup": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "tools:BashTool",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/claude-hooks/warn_dangerous_bash.sh"
          },
          {
            "type": "command",
            "command": ".claude/scripts/claude-hooks/block_main_commits.sh"
          },
          {
            "type": "command",
            "command": ".claude/scripts/claude-hooks/require_impact_analysis.sh"
          },
          {
            "type": "command",
            "command": ".claude/scripts/claude-hooks/block_credential_read.sh"
          }
        ]
      },
      {
        "matcher": "tools:EditTool",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/claude-hooks/block_credential_write.sh"
          }
        ]
      },
      {
        "matcher": "tools:WriteTool",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/claude-hooks/block_credential_write.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "tools:BashTool",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/claude-hooks/auto_format_python.sh"
          },
          {
            "type": "command",
            "command": ".claude/scripts/claude-hooks/run_targeted_tests.sh"
          }
        ]
      },
      {
        "matcher": "tools:EditTool",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/claude-hooks/remind_proposal_review.sh"
          }
        ]
      },
      {
        "matcher": "tools:WriteTool",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/claude-hooks/remind_proposal_review.sh"
          }
        ]
      }
    ]
  }
}
