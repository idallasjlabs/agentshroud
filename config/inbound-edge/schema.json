{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentshroud.ai/schemas/inbound-edge/vendor-profile.json",
  "title": "AgentShroud Inbound MCP Edge vendor profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["vendor", "display_name", "connection", "support", "enabled", "mode", "auth", "tools", "limits", "dlp", "max_response_bytes"],
  "properties": {
    "vendor": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 64},
    "connection": {"enum": ["mcp", "chat-bridge"]},
    "support": {"enum": ["documented", "unconfirmed"]},
    "docs": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 512}},
    "enabled": {"type": "boolean"},
    "mode": {"enum": ["enforce", "monitor"]},
    "monitor_ack": {"type": "boolean"},
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oauth", "dynamic_registration", "redirect_uris", "static_bearer"],
      "properties": {
        "oauth": {"type": "boolean"},
        "dynamic_registration": {"type": "boolean"},
        "redirect_uris": {
          "type": "array",
          "maxItems": 8,
          "items": {"type": "string", "maxLength": 512}
        },
        "static_bearer": {"type": "boolean"}
      }
    },
    "source_cidrs": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 64}},
    "tools": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {"enum": ["read", "write"]}
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["per_client_per_minute", "per_vendor_per_minute", "max_concurrency", "daily_calls", "daily_delegations"],
      "properties": {
        "per_client_per_minute": {"type": "integer", "minimum": 1, "maximum": 600},
        "per_vendor_per_minute": {"type": "integer", "minimum": 1, "maximum": 1200},
        "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 32},
        "daily_calls": {"type": "integer", "minimum": 1, "maximum": 100000},
        "daily_delegations": {"type": "integer", "minimum": 0, "maximum": 1000}
      }
    },
    "dlp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "min_confidence"],
      "properties": {
        "mode": {"enum": ["redact", "block"]},
        "min_confidence": {"type": "number", "maximum": 1.0}
      }
    },
    "max_response_bytes": {"type": "integer", "minimum": 1024, "maximum": 4194304},
    "allowed_hours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "tz"],
      "properties": {
        "start": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
        "end": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
        "tz": {"type": "string", "maxLength": 64}
      }
    }
  }
}
