    "github-idallasj": {
      "command": ".llm_settings/mcp-servers/github/idallasj/github-mcp-wrapper.sh",
      "args": [],
      "timeout": 60000,
      "trust": false
    },
    "github-fluence": {
      "command": ".llm_settings/mcp-servers/github/fluence/github-mcp-wrapper.sh",
      "args": [],
      "timeout": 60000,
      "trust": false
    },
    "github-agentshroud": {
      "command": ".llm_settings/mcp-servers/github/agentshroud/github-mcp-wrapper.sh",
      "args": [],
      "timeout": 60000,
      "trust": false
    },
    "atlassian-fluence": {
      "command": ".llm_settings/mcp-servers/atlassian/fluence/mcp-atlassian.sh",
      "args": [],
      "timeout": 1800000,
      "trust": false
    },
    "atlassian-agentshroud": {
      "command": ".llm_settings/mcp-servers/atlassian/agentshroud/mcp-atlassian.sh",
      "args": [],
      "timeout": 1800000,
      "trust": false
    },
    "atlassian-idallasj": {
      "command": ".llm_settings/mcp-servers/atlassian/idallasj/mcp-atlassian.sh",
      "args": [],
      "timeout": 1800000,
      "trust": false
    },
    "awslabs.aws-api-mcp-server": {
      "command": "/opt/homebrew/bin/uvx",
      "args": [
        "awslabs.aws-api-mcp-server@latest",
        "--readonly"
      ],
      "env": {
        "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin",
        "AWS_PROFILE": "default",
        "AWS_REGION": "us-east-1",
        "FASTMCP_LOG_LEVEL": "CRITICAL",
        "FASTMCP_NO_BANNER": "1"
      },
      "timeout": 600000,
      "trust": false
    },
    "xmind": {
      "command": "/Users/ijefferson.admin/.nvm/versions/node/v20.20.2/bin/npx",
      "args": [
        "-y",
        "xmind-generator-mcp"
      ],
      "env": {
        "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin",
        "outputPath": "${HOME}/Desktop",
        "autoOpenFile": "true"
      },
      "timeout": 60000,
      "trust": false
    },
    "safari": {
      "command": "/Users/ijefferson.admin/.nvm/versions/node/v20.20.2/bin/npx",
      "args": [
        "-y",
        "safari-mcp"
      ],
      "env": {
        "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
      },
      "timeout": 60000,
      "trust": false
    },
    "home-assistant": {
      "command": ".llm_settings/mcp-servers/home-assistant/mcp-ha.sh",
