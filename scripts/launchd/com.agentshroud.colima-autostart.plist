<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agentshroud.colima-autostart</string>

    <!-- Defense-in-depth only: fires when this account logs into the GUI
         (console or screen-share), NOT on a headless pre-login boot. The
         actual guarantee for scripts/sunday-upgrade.sh's unattended run is
         that script's own Colima check/start at the top -- this LaunchAgent
         just gets a normal interactive login back to a working state faster,
         without anyone having to remember to run `colima start` by hand. -->
    <!-- 2026-10-16: no --cpu/--memory/--disk here any more. Colima persists
         the last-used sizing in ~/.colima/default/colima.yaml and reuses it
         when started without sizing flags, so that file is the per-host
         source of truth (prod larger than dev, owner directive). Hard-coding
         a shape here re-imposed it on every login regardless of what the
         host had been resized to. Same rule in docker/scripts/
         colima-health-check.sh (_colima_vm_flags). -->
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/colima</string>
        <string>start</string>
        <string>--network-address</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>

    <!-- Required: launchd hands a job a minimal PATH that excludes
         Homebrew's bin dir (same class of bug com.agentshroud.sunday-upgrade
         .plist already documents). colima's own binary is found fine via
         the absolute path above, but it internally shells out to `limactl`
         via a bare PATH lookup -- without this, RunAtLoad fails with
         "limactl: executable file not found in $PATH" on every login,
         silently defeating the whole point of this LaunchAgent. Found live
         2026-09-19 installing this on prod, the night before this repo's
         first unattended Sunday run. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- Per-account log paths, never /tmp. Both accounts install this job,
         and with a shared log under /tmp, whichever runs first creates it as
         itself, 0644 — launchd then cannot open them for the other account
         and refuses to spawn its job at all (verified 2026-09-19). Written
         with prod's home like com.agentshroud.sunday-upgrade.plist;
         scripts/launchd/install.sh substitutes the installing account's
         $HOME, which is a no-op on prod. -->
    <key>StandardOutPath</key>
    <string>/Users/ijefferson.admin/Library/Logs/colima-autostart.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ijefferson.admin/Library/Logs/colima-autostart.err</string>
</dict>
</plist>
