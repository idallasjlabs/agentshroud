#!/usr/bin/env bash
# asb — AgentShroud Bot helper
# Works on any server: resolves compose override file from hostname.
# Usage: asb {build|up|down|rebuild|pull|status|logs [service]|test}

set -euo pipefail

# Pin Docker API version to the server's maximum to prevent "client version too new" errors
# when the host Docker CLI is newer than the Docker Engine inside the Colima VM.
export DOCKER_API_VERSION="${DOCKER_API_VERSION:-1.53}"

# Ensure the Colima Docker socket is group-writable (required on macOS with Colima).
# Each user runs their own Colima VM; DOCKER_HOST selects the correct socket.
_COLIMA_SOCK="$HOME/.colima/default/docker.sock"
if [ -S "$_COLIMA_SOCK" ]; then
  chmod g+rw "$_COLIMA_SOCK" 2>/dev/null || true
  export DOCKER_HOST="unix://$_COLIMA_SOCK"
fi

HOST=$(hostname -s)
SCRIPT_PATH="${BASH_SOURCE[0]}"
[ -L "$SCRIPT_PATH" ] && SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
REPO_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"

# Pinned vendor versions (OPENCLAW_VERSION, HERMES_IMAGE, HERMES_VERSION) — single
# source of truth shared with scripts/update-agentshroud.sh and CI. Exported into
# the real shell environment (not just passed as --env-file) so docker-compose.yml's
# ${OPENCLAW_VERSION}/${HERMES_IMAGE} build-arg interpolation sees them regardless
# of which compose binary/version is in use or what directory this is invoked from.
if [ -f "$REPO_DIR/docker/versions.env" ]; then
  set -a
  # shellcheck source=docker/versions.env
  . "$REPO_DIR/docker/versions.env"
  set +a
else
  echo "ERROR: $REPO_DIR/docker/versions.env not found — required for pinned vendor builds" >&2
  exit 1
fi

# ── Container-runtime detection (SCRUM-92) ───────────────────────────────────
# Resolve which compose command this host has (docker-compose / docker compose /
# podman-compose / podman compose). On the deploy hosts the standalone
# docker-compose binary is present and wins first, so production behavior is
# unchanged. CE is the base command; all $COMPOSE strings below build on it.
# shellcheck source=scripts/lib/container-runtime.sh
. "$REPO_DIR/scripts/lib/container-runtime.sh"
CE="$(detect_container_runtime)" || exit 1

# Project name: "agentshroud" for prod, "agentshroud-bot" for bot account.
# Exported so docker-compose.yml's ${PROJECT:-agentshroud} interpolation can
# pass it through to containers that need to know their own compose-project-
# prefixed network names (e.g. OpenClaw's sandbox.docker.network config).
if [ "$USER" = "agentshroud-bot" ]; then
  PROJECT="agentshroud-bot"
else
  PROJECT="agentshroud"
fi
export PROJECT

if [ "$USER" = "agentshroud-bot" ]; then
  OVERRIDE="$REPO_DIR/docker/docker-compose.agentshroud-bot.${HOST}.yml"
  if [ ! -f "$OVERRIDE" ]; then
    echo "ERROR: no compose override for host '${HOST}' — expected: $OVERRIDE" >&2
    exit 1
  fi
  COMPOSE="$CE -f $REPO_DIR/docker/docker-compose.yml -f $OVERRIDE -p $PROJECT"
else
  COMPOSE="$CE -f $REPO_DIR/docker/docker-compose.yml -p $PROJECT"
fi

# ── Instance banner ──────────────────────────────────────────────────────────
# Prints a one-line banner identifying which instance asb is operating on.
# Makes PROD vs DEV immediately obvious when multiple stacks run on the same host.
_asb_banner() {
  local label gw_port bot_port
  if [ "$USER" = "agentshroud-bot" ]; then
    label="DEV"
    case "$HOST" in
      marvin*) gw_port=9080; bot_port=18790 ;;
      *)       gw_port=8080; bot_port=18789 ;;
    esac
  else
    label="PROD"
    gw_port=8080
    bot_port=18789
  fi
  printf '\n== AgentShroud™ [%s] %s@%s  |  project: %s  |  gw: :%s  bot: :%s ==\n\n' \
    "$label" "$USER" "$HOST" "$PROJECT" "$gw_port" "$bot_port"
}

# ── Secrets injection ────────────────────────────────────────────────────────
# Reads secrets from the credential backend (1Password/Keychain/secret-tool)
# into a fixed-path directory under $HOME, generates a compose override that
# remaps all secrets: file: paths to that directory. The directory persists as
# long as containers are running — Docker Compose (standalone) bind-mounts
# secrets directly from the host path, so deleting them while containers run
# causes "No such file or directory" inside the container. Cleanup is done by
# `asb down` and at the start of each `asb up`/`rebuild` to rotate secrets.
# Each user ($HOME) keeps their own secrets dir — PROD and DEV stay isolated.
# $HOME must be virtiofs-mounted in Colima (see ~/.colima/default/colima.yaml).
setup_ephemeral_secrets() {
  local tmpdir="$HOME/.agentshroud/.asb-secrets"
  # Wipe previous secrets before writing new ones (ensures rotation).
  rm -rf "$tmpdir"
  mkdir -p "$tmpdir"

  # ── Step 1: Create empty placeholders for ALL secrets referenced in the
  # compose override. This must happen BEFORE extract so Docker Compose always
  # has valid bind-mount source paths even when a secret was never stored.
  # Real values from the credential backend overwrite these in Step 3.
  for name in gateway_password anthropic_oauth_token openai_api_key google_api_key \
              1password_bot_email 1password_bot_master_password 1password_bot_secret_key \
              telegram_bot_token_production telegram_bot_token_marvin \
              telegram_bot_token_trillian telegram_bot_token_rpi \
              slack_bot_token slack_signing_secret slack_app_token \
              hermes_telegram_bot_token hermes_telegram_bot_token_marvin hermes_api_key \
              slack_bot_token_hermes slack_app_token_hermes \
              brave_api_key github_pat \
              hermes_healthchecks_url feedbin_email feedbin_password \
              podcastindex_api_key podcastindex_api_secret; do
    touch "$tmpdir/${name}.txt"
  done

  # gateway_password is a locally-generated shared secret (not something pulled
  # from a credential backend in Step 3 below), so it's the ONE secret this
  # function must get right on its own. Any container that reads it via
  # docker-compose's own `secrets:` block (docker/docker-compose.yml) — not via
  # this ephemeral tmpdir — reads docker/secrets/gateway_password.txt directly.
  # Regenerating a fresh random value here on every rebuild, unconditionally,
  # silently diverges this ephemeral copy from that canonical file — any
  # container using THIS copy (e.g. Hermes, deployed via run-standalone.sh, not
  # compose) then fails every authenticated call to a container using the
  # canonical one (e.g. Gateway) with a genuine, silent password mismatch. This
  # happened for real: Hermes and Gateway validated against two different
  # passwords for a week (SSH-exec + email-send 401s) before being traced back
  # to exactly this. If the canonical file already has real content, copy it —
  # only fall back to generating a fresh one for a genuine first-time bootstrap
  # (no canonical file yet at all).
  local canonical_gw_pass="$REPO_DIR/docker/secrets/gateway_password.txt"
  if [ -s "$canonical_gw_pass" ]; then
    cp "$canonical_gw_pass" "$tmpdir/gateway_password.txt"
  elif ! python3 -c "import secrets; print(secrets.token_hex(32), end='')" \
      > "$tmpdir/gateway_password.txt" 2>/dev/null; then
    openssl rand -hex 32 > "$tmpdir/gateway_password.txt"
  fi

  # Same class of bug as gateway_password above, for the 1Password bootstrap
  # credentials themselves (email/master password/secret key for the "Agent
  # Shroud Bot Credentials" account). Unlike gateway_password these can never
  # be regenerated — there is no fallback derivation, and Step 3's extract
  # below cannot fetch them FROM 1Password since you need to already be signed
  # in to do that. Left to Step 1's empty placeholder, this silently zeroes
  # out any working bootstrap credential on every single `asb` run, breaking
  # op-wrapper.sh (and anything else that signs in via op-auth-common.sh)
  # inside the container even when docker/secrets/ has verified-working values
  # (observed 2026-09-16: OpenClaw's Brave key load failed with "1Password
  # credentials not found in /run/secrets" right after these files had just
  # been fixed and verified working via the container's static compose
  # secrets mount — asb's ephemeral override silently reintroduced the empty
  # files on the next `asb up`).
  for _bot_cred in 1password_bot_email 1password_bot_master_password 1password_bot_secret_key; do
    local _canonical="$REPO_DIR/docker/secrets/${_bot_cred}.txt"
    if [ -s "$_canonical" ]; then
      cp "$_canonical" "$tmpdir/${_bot_cred}.txt"
    else
      echo "  NOTE: canonical $_canonical is empty/missing — op-wrapper.sh sign-in will fail in containers using this ephemeral secrets dir"
    fi
  done

  # Determine which telegram_bot_token variant to use for this host/user.
  # Falls back to production token if the host-specific token was not stored.
  local tg_file="telegram_bot_token_production.txt"
  local hermes_tg_file="hermes_telegram_bot_token.txt"
  if [ "$USER" = "agentshroud-bot" ]; then
    local host_tg_file host_hermes_tg_file
    case "$HOST" in
      marvin*)       host_tg_file="telegram_bot_token_marvin.txt"
                     host_hermes_tg_file="hermes_telegram_bot_token_marvin.txt" ;;
      trillian*)     host_tg_file="telegram_bot_token_trillian.txt" ;;
      raspberrypi*)  host_tg_file="telegram_bot_token_rpi.txt" ;;
      *)             host_tg_file="" ;;
    esac
    # Select host-specific token after extract runs (may be populated then).
    # Record the desired filename; the post-extract logic below will check -s.
    [ -n "$host_tg_file" ] && tg_file="$host_tg_file"
    [ -n "${host_hermes_tg_file:-}" ] && hermes_tg_file="$host_hermes_tg_file"
  fi

  # ── Step 2: Generate the compose override pointing to the tmpdir.
  # Done before extract so the override always exists regardless of extract outcome.
  local override="$tmpdir/docker-compose.secrets-override.yml"
  cat > "$override" << YAML
secrets:
  gateway_password:
    file: ${tmpdir}/gateway_password.txt
  anthropic_oauth_token:
    file: ${tmpdir}/anthropic_oauth_token.txt
  openai_api_key:
    file: ${tmpdir}/openai_api_key.txt
  google_api_key:
    file: ${tmpdir}/google_api_key.txt
  1password_bot_email:
    file: ${tmpdir}/1password_bot_email.txt
  1password_bot_master_password:
    file: ${tmpdir}/1password_bot_master_password.txt
  1password_bot_secret_key:
    file: ${tmpdir}/1password_bot_secret_key.txt
  telegram_bot_token:
    file: ${tmpdir}/${tg_file}
  slack_bot_token:
    file: ${tmpdir}/slack_bot_token.txt
  slack_signing_secret:
    file: ${tmpdir}/slack_signing_secret.txt
  slack_app_token:
    file: ${tmpdir}/slack_app_token.txt
  hermes_telegram_bot_token:
    file: ${tmpdir}/${hermes_tg_file}
  hermes_api_key:
    file: ${tmpdir}/hermes_api_key.txt
  slack_bot_token_hermes:
    file: ${tmpdir}/slack_bot_token_hermes.txt
  slack_app_token_hermes:
    file: ${tmpdir}/slack_app_token_hermes.txt
  brave_api_key:
    file: ${tmpdir}/brave_api_key.txt
  github_pat:
    file: ${tmpdir}/github_pat.txt
YAML

  # ── Step 3: Extract real secrets from credential backend (best-effort).
  # A missing or locked backend is not fatal — placeholders ensure the stack
  # starts in degraded mode with clear runtime warnings instead of a hard
  # bind-mount error. New users and dev instances without all secrets stored
  # will start successfully; unconfigured features log "not configured".
  AGENTSHROUD_SECRETS_DIR="$tmpdir" "$REPO_DIR/docker/setup-secrets.sh" extract \
    || echo "  WARN: secret extraction incomplete — starting with available secrets only" >&2

  # If a host-specific token was populated by extract, use it; otherwise fall
  # back to production token (which may also be empty on a fresh machine).
  if [ "$USER" = "agentshroud-bot" ] && [ -n "${host_tg_file:-}" ]; then
    if [ -s "$tmpdir/$host_tg_file" ]; then
      tg_file="$host_tg_file"
    else
      echo "  NOTE: host-specific token '$host_tg_file' not found — using production token"
      tg_file="telegram_bot_token_production.txt"
    fi
    if [ -n "${host_hermes_tg_file:-}" ]; then
      if [ -s "$tmpdir/$host_hermes_tg_file" ]; then
        hermes_tg_file="$host_hermes_tg_file"
      else
        echo "  NOTE: host-specific Hermes token '$host_hermes_tg_file' not found — using production token"
        hermes_tg_file="hermes_telegram_bot_token.txt"
      fi
    fi
    # Rewrite override with the resolved tg_file/hermes_tg_file (may have changed after extract).
    cat > "$override" << YAML
secrets:
  gateway_password:
    file: ${tmpdir}/gateway_password.txt
  anthropic_oauth_token:
    file: ${tmpdir}/anthropic_oauth_token.txt
  openai_api_key:
    file: ${tmpdir}/openai_api_key.txt
  google_api_key:
    file: ${tmpdir}/google_api_key.txt
  1password_bot_email:
    file: ${tmpdir}/1password_bot_email.txt
  1password_bot_master_password:
    file: ${tmpdir}/1password_bot_master_password.txt
  1password_bot_secret_key:
    file: ${tmpdir}/1password_bot_secret_key.txt
  telegram_bot_token:
    file: ${tmpdir}/${tg_file}
  slack_bot_token:
    file: ${tmpdir}/slack_bot_token.txt
  slack_signing_secret:
    file: ${tmpdir}/slack_signing_secret.txt
  slack_app_token:
    file: ${tmpdir}/slack_app_token.txt
  hermes_telegram_bot_token:
    file: ${tmpdir}/${hermes_tg_file}
  hermes_api_key:
    file: ${tmpdir}/hermes_api_key.txt
  slack_bot_token_hermes:
    file: ${tmpdir}/slack_bot_token_hermes.txt
  slack_app_token_hermes:
    file: ${tmpdir}/slack_app_token_hermes.txt
  brave_api_key:
    file: ${tmpdir}/brave_api_key.txt
  github_pat:
    file: ${tmpdir}/github_pat.txt
YAML
  fi

  # The Docker daemon inside the Colima VM runs under a different UID and cannot
  # stat files created with chmod 600. Relax permissions on this ephemeral tmpdir
  # so the daemon can bind-mount the files.
  chmod 755 "$tmpdir"
  chmod 644 "$tmpdir"/*.txt 2>/dev/null || true
  # Flush these specific files so Colima's virtiofs sees them before Docker tries
  # to bind-mount. A bare `sync` was used here previously, but macOS's sync(2) is
  # global — it flushes every mounted filesystem, not just this tmpdir — so an
  # unrelated unresponsive volume (Time Machine over SMB, a network share, a
  # disconnected external drive) hangs it indefinitely in uninterruptible I/O wait
  # (kernel state "U"), which not even SIGKILL clears, blocking the whole
  # deployment with zero error output. Reproduced live on a real host: two SMB
  # mounts (Time Machine + a Carbon Copy Cloner destination) left `sync` — and a
  # `timeout`-wrapped `sync`, since timeout still waits for the child to actually
  # exit — hung forever. fsync each secret file individually instead: it only
  # touches this tmpdir's own (local) filesystem, never the unrelated mounts.
  python3 -c "
import os, sys
for name in os.listdir('$tmpdir'):
    path = os.path.join('$tmpdir', name)
    if os.path.isfile(path):
        fd = os.open(path, os.O_RDONLY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)
" || echo "WARN: could not fsync ephemeral secrets — continuing anyway"

  COMPOSE="$COMPOSE -f $override"
}

# ── Device store reset ───────────────────────────────────────────────────────
# After a rebuild the agentshroud-config volume retains stale device tokens from
# the previous container. OpenClaw's Telegram handler tries to upgrade scopes on
# the old entry and loops indefinitely with "pairing required". Resetting
# devices/paired.json and devices/pending.json forces a clean re-pair on startup.
# Called after `docker compose up -d` in rebuild paths only — not on plain `up`.
_reset_device_store() {
  local bot_container
  bot_container="$($COMPOSE ps --format '{{.Name}}' openclaw 2>/dev/null | head -1)"
  if [ -z "$bot_container" ]; then
    echo "  [device-reset] bot container not found — skipping"
    return
  fi

  # Wait up to 30 s for the container to be running before exec-ing into it.
  local i=0
  until docker inspect --format '{{.State.Running}}' "$bot_container" 2>/dev/null \
        | grep -q true; do
    i=$((i + 1))
    [ $i -ge 30 ] && { echo "  [device-reset] timeout waiting for $bot_container"; return; }
    sleep 1
  done

  echo "  [device-reset] clearing stale device tokens in $bot_container"
  docker exec "$bot_container" bash -c \
    'echo "{}" > /home/node/.openclaw/devices/paired.json && \
     echo "{}" > /home/node/.openclaw/devices/pending.json' 2>/dev/null \
    && echo "  [device-reset] done — restarting bot for clean re-pair" \
    || { echo "  [device-reset] exec failed — skipping"; return; }
  docker restart "$bot_container" >/dev/null
}

# ── Hermes standalone launch (docker run, not compose) ──────────────────────
# 2026-07-18: a restart storm reproduces only when Hermes is started via
# `docker-compose up -d`; the identical container launched with `docker run`
# stays stable. Hermes now deploys through docker/bots/hermes/run-standalone.sh
# instead of compose. Gateway/openclaw/voice-gateway are unaffected — they
# still deploy via $COMPOSE exactly as before. See project memory
# project_hermes_do_request_ptb226_fix.md for the full investigation.
_hermes_up() {
  # run-standalone.sh reads AGENTSHROUD_MODEL_MODE/AGENTSHROUD_LOCAL_MODEL_REF/
  # AGENTSHROUD_LOCAL_MODEL/HERMES_MAIN_MODEL from the CALLING shell's env at
  # container-creation time, not from docker/.env automatically. Without this,
  # asb rebuild/up silently defaults Hermes to AGENTSHROUD_MODEL_MODE=cloud
  # (Anthropic), which then fails every cron job with a missing-credential
  # error since this deployment intentionally runs on a local model. Same fix
  # already applied in scripts/update-agentshroud.sh — see that script's
  # comment for the full incident history.
  set -a
  # shellcheck source=docker/.env
  . "$REPO_DIR/docker/.env" 2>/dev/null || true
  set +a
  AGENTSHROUD_PROJECT="$PROJECT" \
  AGENTSHROUD_VERSION="${AGENTSHROUD_VERSION:-latest}" \
  AGENTSHROUD_SECRETS_DIR="$HOME/.agentshroud/.asb-secrets" \
    bash "$REPO_DIR/docker/bots/hermes/run-standalone.sh" up
}

_hermes_down() {
  bash "$REPO_DIR/docker/bots/hermes/run-standalone.sh" down 2>/dev/null || true
}

# ── Docker disk reclamation ──────────────────────────────────────────────────
# Removes stopped containers, dangling images, unused networks, and BuildKit
# cache to reclaim disk on the Colima VM before builds. Safe to run without
# stopping running containers — running containers and named volumes are NOT removed.
# Each step is wrapped in a 30-second timeout — BuildKit prune is known to hang
# on Colima when the daemon is in a bad state.
#
# ⚠ NEVER run `docker system prune --volumes` manually — it deletes ALL named
#   volumes including gateway-data, agentshroud-workspace, agentshroud-config, etc.
#   Ollama models (~/.ollama) and mlx_lm models (~/.cache/huggingface) live on the
#   macOS host and are safe, but Docker volumes would be permanently lost.
#   Always use `asb prune` or `asb clean-rebuild` which explicitly preserve volumes.
# OpenClaw's sandboxed exec/read/write/edit tools (agents.defaults.sandbox.*,
# see docker/scripts/init-openclaw-config.sh) spawn per-task containers from
# openclaw-sandbox:bookworm-slim as PEERS of the OpenClaw container via the
# shared docker socket — OpenClaw does not build this image itself, and does
# not silently substitute plain debian:bookworm-slim when it's missing
# (fails fast instead, per OpenClaw's own sandboxing docs). It also cannot be
# built from INSIDE the OpenClaw container: docker-socket-proxy's BUILD
# permission is deliberately 0 (docker/docker-compose.yml) so a compromised
# agent can't build/run arbitrary images — widening that would be a real
# security regression, not a convenience fix. So this must run host-side,
# with the host's own unrestricted docker access, on every up/rebuild — a
# fresh host or a pruned image store had no way to get this image otherwise
# (observed 2026-09-18: cron jobs needing sandbox isolation failed with
# "Sandbox image not found" until someone built it by hand, once, and that
# build did not survive a host rebuild).
_ensure_sandbox_image() {
  if docker image inspect openclaw-sandbox:bookworm-slim >/dev/null 2>&1; then
    return 0
  fi
  echo "Building openclaw-sandbox:bookworm-slim (missing — required for sandboxed cron jobs)..."
  docker build -t openclaw-sandbox:bookworm-slim - <<'DOCKERFILE'
FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
  bash ca-certificates curl git jq python3 ripgrep \
  && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home --shell /bin/bash sandbox
USER sandbox
WORKDIR /home/sandbox
CMD ["sleep", "infinity"]
DOCKERFILE
}

_prune_docker() {
  echo "Pruning stopped containers, dangling images, and BuildKit cache..."
  timeout 30 docker container prune -f 2>/dev/null || true
  timeout 30 docker image prune -f 2>/dev/null || true
  timeout 30 docker network prune -f 2>/dev/null || true
  timeout 60 docker builder prune -f 2>/dev/null \
    || timeout 60 docker buildx prune -f 2>/dev/null \
    || echo "  BuildKit prune timed out — continuing anyway"
  _prune_superseded_images
  _fstrim_colima_datadisk
  echo "Docker prune complete. Named volumes preserved."
}

# `docker rmi`/image prune only frees space INSIDE the Colima VM's guest
# filesystem — the VM's own sparse disk file on the host (~/.colima/_lima/
# _disks/colima/datadisk) never shrinks back on its own, because deleting a
# file only marks guest blocks free; it does not TRIM/discard them back to
# the host-side sparse file. Confirmed 2026-09-19: after a full asb prune
# reclaimed images inside the VM, `df -h` on the host was essentially
# unchanged (97% -> 96%) because the datadisk's host-side allocation stayed
# at ~160GB of its 200GB apparent size. `colima ssh -- sudo fstrim -av`
# reclaimed ~11.5GB immediately. Prod hit and fixed the identical pattern on
# its own datadisk the same day. Without this, `asb prune`'s own log
# ("Docker prune complete") is exactly the class of step-not-outcome false
# green CLAUDE.md section 0.0 exists to catch: the prune step ran, but the disk
# space it claims to have freed was still not available to the host.
_fstrim_colima_datadisk() {
  command -v colima >/dev/null 2>&1 || return 0
  colima status >/dev/null 2>&1 || return 0
  echo "Trimming Colima VM disk (reclaims freed image space back to the host)..."
  timeout 60 colima ssh -- sudo fstrim -av 2>/dev/null || echo "  fstrim failed or timed out — continuing anyway"
}

# `docker image prune` only removes DANGLING images — superseded *tagged*
# versions (agentshroud-gateway:1.5.0/1.5.1/…, ad-hoc snapshot tags like
# cve-fix-*/rollback-*/*-candidate, and the whole agentshroud-rollback/*
# namespace) pile up forever and have twice filled the Colima VM disk
# (2026-08-30: 148 images/92.8GB, ENOSPC mid-build; 2026-09-13: forced a
# 60G->200G resize). Keep the newest 2 per repo — current + one rollback
# baseline, same retention as the Sunday upgrade flow — and remove the
# rest. `docker rmi` refuses images in use by a container, so a running
# old version is never deleted.
#
# Real semver release tags (1.6.0, 1.5.3, ...) sort correctly with
# `sort -V`, but ad-hoc snapshot tags (cve-fix-20260905, rollback-20260830,
# scrum174-candidate) do NOT — mixing both kinds in one version-sort can
# keep the wrong "newest" tag. So semver tags are retained by version
# order, and everything else (ad-hoc tags on the live repos, plus the
# separate agentshroud-rollback/* namespace, which is entirely non-semver)
# is retained by actual image creation time instead.
_prune_superseded_images() {
  local repo tag

  for repo in agentshroud-gateway agentshroud-openclaw agentshroud/hermes \
              agentshroud-voice-gateway agentshroud-wazuh-agent; do
    docker images --filter "reference=${repo}" --format '{{.Tag}}' 2>/dev/null \
      | { grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' || true; } \
      | sort -rV | tail -n +3 \
      | while read -r tag; do
          echo "  [superseded] removing ${repo}:${tag}"
          timeout 30 docker rmi "${repo}:${tag}" 2>/dev/null || true
        done
  done

  for repo in agentshroud-gateway agentshroud-openclaw agentshroud/hermes \
              agentshroud-hermes agentshroud-voice-gateway agentshroud-wazuh-agent \
              agentshroud-rollback/agentshroud-gateway \
              agentshroud-rollback/agentshroud-openclaw \
              agentshroud-rollback/agentshroud-hermes-v2 \
              agentshroud-rollback/agentshroud-voice-gateway \
              agentshroud-rollback/agentshroud-wazuh-agent \
              agentshroud-rollback/agentshroud-docker-socket-proxy; do
    docker images --filter "reference=${repo}" --format '{{.Tag}}|{{.CreatedAt}}' 2>/dev/null \
      | { awk -F'|' '$1 !~ /^[0-9]+\.[0-9]+\.[0-9]+$/ && $1 != "latest" && $1 != "<none>"' || true; } \
      | sort -t'|' -k2 -r \
      | tail -n +3 | cut -d'|' -f1 \
      | while read -r tag; do
          echo "  [superseded-snapshot] removing ${repo}:${tag}"
          timeout 30 docker rmi "${repo}:${tag}" 2>/dev/null || true
        done
  done
}

_asb_banner

# ── Config file pre-flight ───────────────────────────────────────────────────
# agentshroud.yaml is .gitignore'd (per-host config). If the file is missing,
# Docker creates an empty directory as a bind-mount placeholder, crashing the
# gateway with IsADirectoryError. Auto-create from example if needed.
_CONFIG="$REPO_DIR/agentshroud.yaml"
_CONFIG_EXAMPLE="$REPO_DIR/agentshroud.yaml.example"
if [ -d "$_CONFIG" ]; then
  echo "WARNING: agentshroud.yaml is a directory (Docker placeholder) — removing"
  rm -rf "$_CONFIG"
fi
if [ ! -f "$_CONFIG" ] && [ -f "$_CONFIG_EXAMPLE" ]; then
  echo "Creating agentshroud.yaml from example template (edit $REPO_DIR/agentshroud.yaml to customize)"
  cp "$_CONFIG_EXAMPLE" "$_CONFIG"
fi

# ── hermes-config/cron pre-flight ────────────────────────────────────────────
# Gateway bind-mounts the hermes-config volume's `cron` SUBPATH read-only
# (docker-compose.yml, CronStateMonitor / SCRUM-61) so it never sees the rest
# of hermes-config (auth.json, mcp.json credentials). Docker's subpath mount
# requires the subdirectory to already exist — it will NOT auto-create it.
# On a truly fresh install (hermes-config volume never touched by Hermes yet),
# gateway fails to start with "cannot access path .../cron: no such file or
# directory" — and gateway must be healthy before Hermes ever runs, so Hermes
# never gets the chance to create it either. Break the deadlock by ensuring
# the directory exists before the stack ever comes up.
docker volume create hermes-config >/dev/null 2>&1 || true
docker run --rm -v hermes-config:/data alpine mkdir -p /data/cron >/dev/null 2>&1 || true

case "${1:-}" in
  build)
    _prune_docker
    $COMPOSE build --no-cache
    ;;
  up)
    _PROFILE_FLAG=""
    _WANT_HERMES=0
    [[ "${2:-}" == "full" ]] && { _PROFILE_FLAG="--profile voice"; _WANT_HERMES=1; }
    [[ "${2:-}" == "hermes" ]] && _WANT_HERMES=1
    setup_ephemeral_secrets
    _ensure_sandbox_image
    $COMPOSE $_PROFILE_FLAG up -d
    [[ "$_WANT_HERMES" == "1" ]] && _hermes_up
    bash "$REPO_DIR/scripts/post-deploy-check.sh" || true
    # Hermes/OpenClaw's own per-task sandbox containers (--network none) are
    # never cleaned up by the vendored tools themselves — a stuck/failing cron
    # job can silently accumulate dozens of exited containers between manual
    # `asb prune` runs (2026-08-20). Sweep them on every routine bring-up too,
    # not just build/rebuild.
    _prune_docker
    ;;
  down)
    # --profile full stops voice-gateway if running (Hermes is not compose-managed)
    $COMPOSE --profile full down
    _hermes_down
    rm -rf "$HOME/.agentshroud/.asb-secrets"
    ;;
  rebuild)
    _PROFILE_FLAG=""
    _WANT_HERMES=0
    [[ "${2:-}" == "full" ]] && { _PROFILE_FLAG="--profile voice"; _WANT_HERMES=1; }
    [[ "${2:-}" == "hermes" ]] && _WANT_HERMES=1
    _hermes_down
    $COMPOSE --profile full down 2>/dev/null || true
    _prune_docker
    setup_ephemeral_secrets
    $COMPOSE build --no-cache
    [[ "$_WANT_HERMES" == "1" ]] && $COMPOSE build hermes --no-cache
    _ensure_sandbox_image
    $COMPOSE $_PROFILE_FLAG up -d
    [[ "$_WANT_HERMES" == "1" ]] && _hermes_up
    _reset_device_store
    bash "$REPO_DIR/scripts/post-deploy-check.sh" || true
    ;;
  clean-rebuild)
    _PROFILE_FLAG=""
    _WANT_HERMES=0
    [[ "${2:-}" == "full" ]] && { _PROFILE_FLAG="--profile voice"; _WANT_HERMES=1; }
    [[ "${2:-}" == "hermes" ]] && _WANT_HERMES=1
    echo "This will remove containers, prune stale volumes, and rebuild from scratch."
    echo "Persistent data (workspace, config, SSH keys, browsers) is PRESERVED."
    echo "hermes-config volume is NEVER deleted (preserves Hermes state across rebuilds)."
    read -r -p "Continue? [y/N] " confirm
    [[ "$confirm" =~ ^[Yy]$ ]] || { echo "Aborted."; exit 0; }
    _hermes_down
    $COMPOSE --profile full down
    for vol in gateway-data clamav-db; do
      docker volume rm "${PROJECT}_${vol}" 2>/dev/null && echo "  Removed ${PROJECT}_${vol}" || true
    done
    # hermes-config is intentionally excluded — it persists Hermes skills, cron, MCP, memory
    _prune_docker
    setup_ephemeral_secrets
    $COMPOSE build --no-cache
    [[ "$_WANT_HERMES" == "1" ]] && $COMPOSE build hermes --no-cache
    _ensure_sandbox_image
    $COMPOSE $_PROFILE_FLAG up -d
    [[ "$_WANT_HERMES" == "1" ]] && _hermes_up
    _reset_device_store
    echo "Clean rebuild complete."
    ;;
  prune)   _prune_docker ;;
  pull)    cd "$REPO_DIR" && git pull --rebase ;;
  status)
    $COMPOSE ps
    bash "$REPO_DIR/docker/bots/hermes/run-standalone.sh" status 2>/dev/null || true
    ;;
  logs)
    if [[ "${2:-}" == "hermes" ]]; then
      bash "$REPO_DIR/docker/bots/hermes/run-standalone.sh" logs
    else
      $COMPOSE logs -f --tail=100 ${2:-}
    fi
    ;;
  test)    $COMPOSE exec gateway python -m pytest gateway/tests/ -q ;;
  canary)
    SERVICE=${2:-gateway}
    CANARY_PROJECT="agentshroud-canary"
    echo "[asb canary] Starting canary instance of $SERVICE on alternate ports (+100)..."
    # Start canary instance with offset ports
    $CE -f docker/docker-compose.yml \
      -p "$CANARY_PROJECT" \
      up -d "$SERVICE" \
      2>&1 || { echo "[asb canary] Failed to start canary"; exit 1; }
    echo "[asb canary] Canary started. Waiting 60s for soak..."
    sleep 60
    # Health check both instances
    PRIMARY_HEALTH=$(curl -sf http://localhost:8080/status > /dev/null 2>&1 && echo "healthy" || echo "unhealthy")
    CANARY_HEALTH=$(curl -sf http://localhost:8180/status > /dev/null 2>&1 && echo "healthy" || echo "unhealthy")
    echo "[asb canary] Primary: $PRIMARY_HEALTH | Canary: $CANARY_HEALTH"
    if [ "$CANARY_HEALTH" != "healthy" ]; then
      echo "[asb canary] Canary unhealthy — stopping canary, primary untouched"
      $CE -f docker/docker-compose.yml -p "$CANARY_PROJECT" down
      exit 1
    fi
    printf "[asb canary] Canary healthy. Promote to primary? [y/N]: "
    read -r PROMOTE
    if [ "$PROMOTE" = "y" ] || [ "$PROMOTE" = "Y" ]; then
      echo "[asb canary] Promoting canary..."
      $CE -f docker/docker-compose.yml down
      $CE -f docker/docker-compose.yml -p "$CANARY_PROJECT" down
      $CE -f docker/docker-compose.yml up -d
      echo "[asb canary] Canary promoted. Primary restarted."
    else
      echo "[asb canary] Promotion declined. Stopping canary."
      $CE -f docker/docker-compose.yml -p "$CANARY_PROJECT" down
    fi
    ;;
  rollback)
    PREV_IMAGE_FILE=".asb-previous-image"
    if [ ! -f "$PREV_IMAGE_FILE" ]; then
      echo "[asb rollback] No previous image recorded at $PREV_IMAGE_FILE"
      echo "[asb rollback] Cannot rollback — run 'asb rebuild' at least once to record a baseline"
      exit 1
    fi
    PREV_IMAGE=$(cat "$PREV_IMAGE_FILE")
    echo "[asb rollback] Rolling back to: $PREV_IMAGE"
    $CE -f docker/docker-compose.yml down
    GATEWAY_IMAGE="$PREV_IMAGE" $CE -f docker/docker-compose.yml up -d
    echo "[asb rollback] Rollback complete. Running post-deploy check..."
    sleep 5
    curl -sf http://localhost:8080/status && echo " [ok]" || echo " [warning: health check failed]"
    ;;
  instances)
    echo "[asb instances] Running AgentShroud instances:"
    docker ps --filter "name=agentshroud" --format "table {{.Names}}\t{{.Ports}}\t{{.Status}}" 2>/dev/null || echo "No running instances found"
    ;;
  *)
    echo "Usage: asb {build|up [full]|down|rebuild [full]|clean-rebuild [full]|prune|pull|status|logs [service]|test|canary [service]|rollback|instances}"
    echo "  Add 'full' to up/rebuild/clean-rebuild to start Hermes + HCI (--profile full)"
    exit 1
    ;;
esac
