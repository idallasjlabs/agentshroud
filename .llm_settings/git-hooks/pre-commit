#!/bin/bash
set -e

echo "🔍 Scanning for secrets..."

# Check if gitleaks is installed
if command -v gitleaks &> /dev/null; then
    if [ -f gitleaks.toml ]; then
        GITLEAKS_ARGS=(--config=gitleaks.toml)
    else
        GITLEAKS_ARGS=()
    fi
    if ! gitleaks protect --staged "${GITLEAKS_ARGS[@]}"; then
        echo "❌ SECRETS DETECTED! Commit blocked by gitleaks."
        exit 1
    fi
else
    echo "❌ gitleaks not installed. Commit blocked — secret scanning cannot be skipped."
    if command -v brew &>/dev/null; then
        echo "   Install with: brew install gitleaks"
    else
        echo "   See: https://github.com/gitleaks/gitleaks#installing"
    fi
    exit 1
fi

# Check if git-secrets is installed
if command -v git-secrets &> /dev/null; then
    if ! git secrets --pre_commit_hook -- "$@"; then
        echo "❌ SECRETS DETECTED! Commit blocked by git-secrets."
        exit 1
    fi
else
    echo "❌ git-secrets not installed. Commit blocked — secret scanning cannot be skipped."
    if command -v brew &>/dev/null; then
        echo "   Install with: brew install git-secrets"
    else
        echo "   See: https://github.com/awslabs/git-secrets#installing-git-secrets"
    fi
    exit 1
fi

echo "✅ No secrets detected - commit allowed"
exit 0
