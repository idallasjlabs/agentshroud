{
  "manifest_version": 3,
  "name": "AgentShroud",
  "version": "1.0.0",
  "description": "Forward a URL or clip a page to your AgentShroud gateway — without cookies, session tokens, or trackers.",
  "permissions": ["activeTab", "contextMenus", "scripting", "storage", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AgentShroud: forward this page",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-extension@agentshroud.ai"
    }
  }
}
